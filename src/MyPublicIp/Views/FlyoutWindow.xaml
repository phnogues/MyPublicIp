<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyPublicIp.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MyPublicIp.Views"
    xmlns:vm="using:MyPublicIp.Core.ViewModels">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- The Canvas measures its child with an unlimited height: Root.ActualHeight is the height the window needs -->
    <Canvas>
        <StackPanel x:Name="Root" Width="340" Padding="20,16,20,16" Spacing="14" KeyboardAcceleratorPlacementMode="Hidden">
            <StackPanel.Resources>
                <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
            </StackPanel.Resources>
            <StackPanel.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            </StackPanel.KeyboardAccelerators>

            <!-- Header -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="HeaderText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}" />
                </StackPanel>
                <Grid Grid.Column="1" Width="36" Height="36">
                    <Button
                        x:Uid="RefreshButton"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Visibility="{x:Bind views:Converters.CollapsedWhen(ViewModel.IsRefreshing), Mode=OneWay}">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- IPv4 -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="IPv4" />
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.IPv4Text, Mode=OneWay}" />
                </StackPanel>
                <Button
                    x:Uid="CopyIPv4Button"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Command="{x:Bind ViewModel.CopyIPv4Command}"
                    Visibility="{x:Bind ViewModel.HasIPv4, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind views:Converters.CopyGlyphFor(ViewModel.IsIPv4Copied), Mode=OneWay}" FontSize="16" />
                </Button>
            </Grid>

            <!-- IPv6 -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="IPv6" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.IPv6Text, Mode=OneWay}" />
                </StackPanel>
                <Button
                    x:Uid="CopyIPv6Button"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Command="{x:Bind ViewModel.CopyIPv6Command}"
                    Visibility="{x:Bind ViewModel.HasIPv6, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind views:Converters.CopyGlyphFor(ViewModel.IsIPv6Copied), Mode=OneWay}" FontSize="16" />
                </Button>
            </Grid>

            <!-- Local network -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.LocalNetworkLabel, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.LocalIPv4Text, Mode=OneWay}" />
                </StackPanel>
                <Button
                    x:Uid="CopyLocalButton"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Command="{x:Bind ViewModel.CopyLocalIPv4Command}"
                    Visibility="{x:Bind ViewModel.HasLocalIPv4, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind views:Converters.CopyGlyphFor(ViewModel.IsLocalIPv4Copied), Mode=OneWay}" FontSize="16" />
                </Button>
            </Grid>

            <!-- Recent public addresses -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="{x:Bind ViewModel.HistoryHeader, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Text="{x:Bind When}" />
                                <TextBlock
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    FontWeight="{x:Bind views:Converters.WeightFor(IsCurrent)}"
                                    Text="{x:Bind Address}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Expander>

            <!-- A closed InfoBar keeps its place in the StackPanel spacing: collapse it as well -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Severity="{x:Bind views:Converters.SeverityFor(ViewModel.Status), Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <InfoBar
                x:Uid="PinTipInfoBar"
                Severity="Informational"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsPinTipOpen, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsPinTipOpen, Mode=OneWay}"
                CloseButtonCommand="{x:Bind ViewModel.DismissPinTipCommand}" />

            <Border Height="1" Margin="-20,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <CheckBox
                x:Uid="StartupCheckBox"
                Visibility="{x:Bind ViewModel.IsStartupAvailable, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsStartupOn, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanChangeStartup, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.StartupToolTip, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleStartupCommand}" />

            <CheckBox
                x:Uid="NotifyCheckBox"
                Margin="0,-8,0,0"
                IsChecked="{x:Bind ViewModel.IsNotifyOnChangeOn, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleNotifyOnChangeCommand}" />
        </StackPanel>
    </Canvas>
</Window>
